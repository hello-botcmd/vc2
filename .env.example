# ── Telegram API credentials (my.telegram.org) — used by the userbot(s) ────
API_ID=123456
API_HASH=your_api_hash_here

# ── Control Bot (create via @BotFather) ─────────────────────────────────────
BOT_TOKEN=123456:AAExampleBotTokenHere
# Your numeric Telegram user id — ONLY this user can use the control bot.
# Get it from @userinfobot
OWNER_ID=111111111

# ── Userbot session(s) ───────────────────────────────────────────────────────
# Set SESSION_NAME to use ONE account for VC1, VC2 and channel mirroring.
SESSION_NAME=relay_session
# OR leave SESSION_NAME empty and set these two for a 2-account setup:
# SESSION_LISTENER=listener_session
# SESSION_BROADCASTER=broadcaster_session
# Optional: dedicated 3rd account for mirroring only (defaults to listener)
# SESSION_MIRROR=mirror_session

# ── Voice Chat targets ───────────────────────────────────────────────────────
CHAT_VC1=-1001111111111
CHAT_VC2=-1002222222222
TARGET_DELAY_SEC=2.0
MAX_DELAY_SEC=5.0

# ── Channel mirror (posts/media/stickers copied source -> dest) ────────────
SOURCE_CHANNEL=-1003333333333
DEST_CHANNEL=-1004444444444
MIRROR_ENABLED=true
MIRROR_EDITS=true
MIRROR_DELETES=true
